# Copier ce fichier en `.env` puis adapter les valeurs.
#   cp .env.example .env
# Le fichier `.env` n'est jamais commité (voir .gitignore).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=change_me

# --- pgAdmin (profil `tools`) -------------------------------------------------
PGADMIN_EMAIL=admin@eventflow.local
PGADMIN_PASSWORD=change_me

# --- AWS / LocalStack ---------------------------------------------------------
AWS_REGION=eu-west-3
